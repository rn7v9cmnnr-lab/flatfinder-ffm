# ---------- Suchkriterien ----------
SEARCH_CITY="Frankfurt am Main"
SEARCH_PRICE_MAX=1400
SEARCH_PRICE_IDEAL=1000
SEARCH_SQM_MIN=55
SEARCH_ROOMS_MIN=2
SEARCH_ROOMS_MAX=4
SEARCH_DISTRICTS_PREFERRED='["Sachsenhausen","Bockenheim","Nordend","Ostend","Bornheim"]'
SEARCH_DISTRICTS_EXCLUDED='[]'
SEARCH_ACCEPT_WBS=false
SEARCH_ACCEPT_COMMISSION=true
SEARCH_NOTIFY_THRESHOLD=50
# Auto-Ja: sendet ohne Rueckfrage, wenn du nicht antwortest.
# Bewusst aus. Erst einschalten, wenn du den Texten vertraust.
SEARCH_AUTO_YES_ENABLED=false
SEARCH_AUTO_YES_THRESHOLD=90
SEARCH_AUTO_YES_AFTER_MINUTES=10

# ---------- Bewerberprofil (geht 1:1 in den Text) ----------
# Nur wahre Angaben. Leere Felder werden weggelassen, nicht erfunden.
PROFILE_FULL_NAME=""
PROFILE_EMAIL=""
PROFILE_PHONE=""
PROFILE_OCCUPATION="z.B. Softwareentwickler, unbefristet seit 2021"
PROFILE_EMPLOYER=""
PROFILE_NET_INCOME=0
PROFILE_HOUSEHOLD_SIZE=1
PROFILE_HOUSEHOLD_DETAIL="Nichtraucher, keine Haustiere"
PROFILE_MOVE_IN_FROM="ab sofort"
PROFILE_SCHUFA_AVAILABLE=true
PROFILE_DOCS_READY="SCHUFA-Auskunft, 3 Gehaltsnachweise, Mietschuldenfreiheitsbescheinigung"
PROFILE_VIEWING_AVAILABILITY="kurzfristig, auch abends und am Wochenende"
PROFILE_EXTRA_NOTES=""

# ---------- Claude ----------
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5"

# ---------- Messenger ----------
# telegram = kostenlos, sofort einsatzbereit (Entwicklung)
# whatsapp = Ziel, braucht Meta-Freigabe und kostet pro Nachricht
# web = Dashboard ist der Kanal, kein Token noetig (Standard)
# telegram / whatsapp = zusaetzlich aufs Handy
MESSENGER=web
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_RECIPIENT="49151xxxxxxx"
WHATSAPP_TEMPLATE_NAME="neues_wohnungsangebot"
WHATSAPP_VERIFY_TOKEN="selbst-ausgedachter-string"

# ---------- Versand per Mail ----------
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""

# ---------- Betrieb ----------
DB_PATH="data/flatfinder.db"
# stuendlich. Kuerzer bringt bei Grossvermietern nichts, die
# aktualisieren nicht im Minutentakt.
POLL_INTERVAL_SECONDS=3600
# Gemeinsames Geheimnis zwischen Heim-Node und Core
INGEST_TOKEN=""
# true = generiert Texte, verschickt aber NICHTS. Standard.
DRY_RUN=true

# Alarm-Modus: nur finden und melden, keine Bewerbungen.
NOTIFY_ONLY=true
